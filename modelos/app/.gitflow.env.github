# Configuracao do GitFlow Kit (GitHub). So chaves permitidas; destinos e segredos vao pelo ambiente.
GITFLOW_PROVIDER=github
ARTEFATOS=github-release
DEPLOY=pages
NOTIFICAR=pr-comment
MODO_DEMO=@MODO_DEMO@

# URLs usadas na checagem de saude de cada ambiente (ajuste ao seu Pages).
URL_QA=https://@ORG@.github.io/@APP@/qa
URL_HOM=https://@ORG@.github.io/@APP@/hom
URL_PRD=https://@ORG@.github.io/@APP@

# Teams (slugs) da organizacao.
GRUPO_QA=qa
GRUPO_NEGOCIO=negocio
GRUPO_TL=tech-leads
GRUPO_RM=release-managers

LIMITE_QA=6
